# SalesAutomata — copy to .env and fill in.
# One file drives both the backend and the frontend.

# --- Supabase ---
# Service-side (backend) key. Bypasses RLS. Never ship to the browser.
# Dashboard -> Project Settings -> API -> service_role secret.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=https://iaydmzkytlksabwuylsl.supabase.co

# Publishable (frontend) key — safe for the browser, used by Supabase Auth.
VITE_SUPABASE_URL=https://iaydmzkytlksabwuylsl.supabase.co
VITE_SUPABASE_ANON_KEY=

# --- Backend ---
PORT=8080
CORS_ORIGIN=*

# --- Frontend ---
VITE_API_URL=http://localhost:8080
VITE_CRM_SEND_WEBHOOK_URL=
